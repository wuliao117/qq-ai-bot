{
  "onebot": {
    "host": "127.0.0.1",
    "port": 3002,
    "path": "/onebot/v11/ws",
    "access_token": ""
  },
  "trigger": {
    "require_at": true,
    "prefixes": ["/ai ", "小助手 "],
    "reply_to_bot": true,
    "allow_private": true
  },
  "llm": {
    "base_url": "https://api.deepseek.com/v1",
    "api_key": "",
    "model": "deepseek-chat",
    "temperature": 0.7,
    "max_tokens": 800,
    "timeout": 60,
    "system_prompt": "你是 QQ 群里的一员，名字叫「小助手」。说话自然、口语化，像群里的朋友，不要用 markdown 标题和列表堆砌，不要自称 AI 模型或语言模型。回答简洁，一般 3 句话以内，除非对方明确要求详细展开。有人问到你不确定的事，直接说不确定，不要编造。"
  },
  "context": {
    "ambient": true,
    "ambient_size": 20,
    "max_chars": 4000
  },
  "groups": {
    "whitelist": [],
    "blacklist": []
  },
  "behavior": {
    "reply_with_quote": true,
    "max_replies_per_minute": 6,
    "max_concurrency": 3,
    "max_reply_chars": 900
  }
}
